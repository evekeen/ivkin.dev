---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredPosts = allPosts.slice(0, 6);
---

<BaseLayout>
  <div class="flex flex-col min-h-screen bg-gray-50 dark:bg-[#0a0a0a]">
    <Header />

    <main class="flex-1">
      <!-- Hero -->
      <section class="relative max-w-6xl mx-auto px-6 py-20 sm:py-32">
        <!-- Profile Image with layered effect -->
        <div class="mb-16 flex items-start gap-8 flex-wrap">
          <div class="relative group">
            <div class="absolute -inset-2 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl opacity-75 blur-xl group-hover:opacity-100 transition animate-gradient-morph"></div>
            <img
              src="/images/ava-pro-300.jpg"
              alt="Alexander Ivkin"
              class="relative w-28 h-28 rounded-2xl object-cover border-4 border-white dark:border-gray-900 shadow-2xl"
            />
          </div>

          <div class="flex-1 min-w-[300px]">
            <div class="inline-block mb-3 text-xs font-mono uppercase tracking-widest text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/30 px-3 py-1.5 rounded-full border border-blue-200 dark:border-blue-900">
              Hacking with AI
            </div>
            <h1 class="text-5xl sm:text-6xl font-bold mb-6 text-gray-900 dark:text-white leading-tight">
              Alexander Ivkin
            </h1>
            <p class="text-xl text-gray-700 dark:text-gray-300 leading-relaxed mb-6 max-w-2xl">
              <span id="typing-text" data-text="Helping companies ship production agentic apps and modernize their UX. Co-founder & CTO at Enabled Health Inc. Successful exit: sold Ace Trace mobile app."></span><span id="typing-cursor" class="animate-pulse">|</span>
            </p>

            <div class="flex gap-4 flex-wrap">
              <a
                href="/blog"
                class="group inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-semibold rounded-xl hover:scale-105 transition-transform shadow-lg"
              >
                Read posts
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>

              <a
                href="/consulting"
                class="inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-semibold rounded-xl hover:border-gray-900 dark:hover:border-white hover:text-gray-900 dark:hover:text-white transition-colors"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Book Consulting
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Latest Posts - Scrapbook Grid -->
      <section class="max-w-6xl mx-auto px-6 py-16">
        <div class="mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-3">
            Latest Posts
          </h2>
          <p class="text-gray-600 dark:text-gray-400">Thoughts and experiments from the journey</p>
        </div>

        <!-- Masonry-style grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredPosts.map((post, index) => {
            const colors = [
              'from-blue-500/10 to-purple-500/10 border-blue-200 dark:border-blue-900',
              'from-pink-500/10 to-orange-500/10 border-pink-200 dark:border-pink-900',
              'from-green-500/10 to-teal-500/10 border-green-200 dark:border-green-900',
              'from-violet-500/10 to-fuchsia-500/10 border-violet-200 dark:border-violet-900',
              'from-amber-500/10 to-rose-500/10 border-amber-200 dark:border-amber-900',
              'from-cyan-500/10 to-blue-500/10 border-cyan-200 dark:border-cyan-900',
            ];
            const colorClass = colors[index % colors.length];

            return (
              <article class="group fade-in-up" style={`animation-delay: ${index * 100}ms`}>
                <a href={`/blog/${post.slug}`} class="block">
                  <div class={`relative bg-gradient-to-br ${colorClass} border-2 rounded-2xl p-6 hover:scale-[1.02] transition-all duration-300 bg-white dark:bg-gray-900 shadow-lg hover:shadow-xl h-full`}>
                    {/* Date stamp */}
                    <div class="flex items-center gap-2 mb-4">
                      <time class="text-xs font-mono text-gray-600 dark:text-gray-400">
                        {post.data.date.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        })}
                      </time>
                      {post.data.tags && post.data.tags.length > 0 && (
                        <span class="text-xs text-gray-500 dark:text-gray-500">
                          • {post.data.tags[0]}
                        </span>
                      )}
                    </div>

                    {/* Title */}
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                      {post.data.title}
                    </h3>

                    {/* Description */}
                    {post.data.description && (
                      <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed mb-4 line-clamp-3">
                        {post.data.description}
                      </p>
                    )}

                    {/* Tags */}
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-gray-200 dark:border-gray-800">
                        {post.data.tags.slice(0, 3).map(tag => (
                          <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}

                    {/* Hover indicator */}
                    <div class="absolute top-4 right-4 w-2 h-2 rounded-full bg-blue-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        <!-- View all -->
        <div class="mt-12 text-center">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white font-semibold transition-colors group"
          >
            View all posts
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </section>

      <!-- About Section -->
      <section class="max-w-6xl mx-auto px-6 py-16">
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 sm:p-12 border-2 border-gray-200 dark:border-gray-800 shadow-xl">
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">About</h2>
          <div class="prose prose-lg dark:prose-invert max-w-none">
            <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
              I've spent my career building software products and leading teams. Built Structure.Gantt from scratch and led engineering teams at ALM Works. Founded and sold Ace Trace — a mobile app with 6K paying subscribers. Led AI agent development at Winrate.com. Co-founded Enabled Health Inc, building AI physical therapy for hospitals.
            </p>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
              Now I work independently — helping companies ship production agentic apps and modernize their UX.
            </p>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              This is where I document the journey—the wins, the lessons, and everything in between.
            </p>
          </div>

          <!-- Social Links -->
          <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 flex gap-4">
            <a
              href="https://twitter.com/alexivkin"
              target="_blank"
              rel="noopener"
              class="p-3 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-900 dark:hover:bg-white hover:text-white dark:hover:text-gray-900 rounded-xl transition-colors"
              aria-label="Twitter"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"></path>
              </svg>
            </a>
            <a
              href="https://github.com/evekeen"
              target="_blank"
              rel="noopener"
              class="p-3 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-900 dark:hover:bg-white hover:text-white dark:hover:text-gray-900 rounded-xl transition-colors"
              aria-label="GitHub"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
              </svg>
            </a>
            <a
              href="https://www.linkedin.com/in/evekeen"
              target="_blank"
              rel="noopener"
              class="p-3 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-900 dark:hover:bg-white hover:text-white dark:hover:text-gray-900 rounded-xl transition-colors"
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  /* Animated gradient morphing */
  @keyframes gradient-morph {
    0%, 100% {
      background: linear-gradient(135deg, #3b82f6 0%, #9333ea 100%);
    }
    25% {
      background: linear-gradient(135deg, #06b6d4 0%, #8b5cf6 100%);
    }
    50% {
      background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%);
    }
    75% {
      background: linear-gradient(135deg, #ec4899 0%, #f97316 100%);
    }
  }

  .animate-gradient-morph {
    animation: gradient-morph 8s ease-in-out infinite;
    background-size: 400% 400%;
  }

  /* Scroll-triggered fade-in-up animation */
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .fade-in-up.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Typing cursor blink */
  #typing-cursor {
    display: inline-block;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Glowing text animation - optimized for performance and word wrapping */
  :global(.glow-char) {
    /* Keep as inline to allow natural word wrapping */
    animation: textGlow 1.5s ease-out !important;
  }

  @keyframes textGlow {
    0%, 20% {
      text-shadow:
        0 0 10px rgba(59, 130, 246, 1),
        0 0 20px rgba(59, 130, 246, 0.8),
        0 0 40px rgba(147, 51, 234, 0.6);
      color: #3b82f6 !important;
    }
    50% {
      text-shadow:
        0 0 15px rgba(59, 130, 246, 1),
        0 0 30px rgba(59, 130, 246, 0.9),
        0 0 50px rgba(147, 51, 234, 0.7);
      color: #60a5fa !important;
    }
    100% {
      text-shadow: none !important;
      color: inherit !important;
    }
  }

  /* Dark mode adjustments for glow */
  :global(.dark) :global(.glow-char) {
    animation: textGlowDark 1.5s ease-out !important;
  }

  @keyframes textGlowDark {
    0%, 20% {
      text-shadow:
        0 0 10px rgba(96, 165, 250, 1),
        0 0 20px rgba(96, 165, 250, 0.9),
        0 0 40px rgba(168, 85, 247, 0.7);
      color: #93c5fd !important;
    }
    50% {
      text-shadow:
        0 0 15px rgba(96, 165, 250, 1),
        0 0 30px rgba(96, 165, 250, 1),
        0 0 50px rgba(168, 85, 247, 0.8);
      color: #60a5fa !important;
    }
    100% {
      text-shadow: none !important;
      color: inherit !important;
    }
  }
</style>

<script>
  // Typing animation with glow effect
  const typingText = document.getElementById('typing-text');
  const cursor = document.getElementById('typing-cursor');

  console.log('Typing animation initialized:', { typingText, cursor });

  if (typingText && cursor) {
    const fullText = typingText.getAttribute('data-text') || '';
    let currentIndex = 0;
    let typedText = '';

    console.log('Starting typing animation for:', fullText);

    function typeCharacter() {
      if (!typingText) return;

      if (currentIndex < fullText.length) {
        const char = fullText[currentIndex];
        typedText += char;

        // Build content: typed text + glowing current char
        typingText.innerHTML = typedText.slice(0, -1) +
          '<span class="glow-char">' + (char === ' ' ? '&nbsp;' : char) + '</span>';

        console.log('Typed character:', char, 'at index:', currentIndex);

        currentIndex++;
        setTimeout(typeCharacter, 30);
      } else {
        // Typing complete - show final text without glow
        typingText.textContent = fullText;
        console.log('Typing complete');
        if (cursor) {
          setTimeout(() => {
            cursor.style.display = 'none';
          }, 500);
        }
      }
    }

    // Start typing after a brief delay
    setTimeout(typeCharacter, 500);
  } else {
    console.error('Could not find typing elements');
  }

  // Scroll-triggered animations using Intersection Observer
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  // Observe all elements with fade-in-up class
  document.querySelectorAll('.fade-in-up').forEach(element => {
    observer.observe(element);
  });
</script>
