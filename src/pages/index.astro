---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredPosts = allPosts.slice(0, 6);
---

<BaseLayout>
  <div class="flex flex-col min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-purple-50/30 dark:from-gray-950 dark:via-blue-950/20 dark:to-purple-950/20">
    <Header />

    <main class="flex-1">
      <!-- Hero Section with Neo-Brutalist Style -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <div class="relative">
          <!-- Decorative geometric shapes -->
          <div class="absolute -top-10 -right-10 w-32 h-32 bg-yellow-400 rounded-3xl rotate-12 opacity-20 blur-3xl"></div>
          <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-blue-500 rounded-full opacity-20 blur-3xl"></div>

          <div class="relative bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl border-4 border-gray-900 dark:border-white rounded-2xl p-8 sm:p-12 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:shadow-[8px_8px_0px_0px_rgba(255,255,255,1)] transition-all duration-300 hover:shadow-[12px_12px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[12px_12px_0px_0px_rgba(255,255,255,1)] hover:-translate-y-1">
            <div class="flex flex-col sm:flex-row items-center gap-8">
              <div class="relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-pink-500 via-purple-500 to-blue-500 rounded-full blur-lg group-hover:blur-xl opacity-75 group-hover:opacity-100 transition duration-300"></div>
                <img
                  src="/images/ava-pro-300.jpg"
                  alt="Alexander Ivkin"
                  class="relative w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover border-4 border-gray-900 dark:border-white transition-transform duration-300 group-hover:scale-105"
                />
              </div>

              <div class="flex-1 text-center sm:text-left">
                <div class="inline-block mb-3 px-4 py-1 bg-yellow-300 dark:bg-yellow-500 text-gray-900 font-bold text-sm uppercase tracking-wider border-2 border-gray-900 dark:border-white rounded-full rotate-1 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
                  Indie Hacker
                </div>
                <h1 class="text-5xl sm:text-7xl font-black mb-4 leading-tight">
                  <span class="inline-block bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 bg-clip-text text-transparent hover:from-pink-600 hover:via-purple-600 hover:to-blue-600 transition-all duration-500">
                    Alexander
                  </span>
                  <br />
                  <span class="inline-block text-gray-900 dark:text-white">
                    Ivkin
                  </span>
                </h1>
                <p class="text-xl sm:text-2xl text-gray-700 dark:text-gray-300 leading-relaxed mb-6 font-medium">
                  Building with AI • Hacking on weekends • Sharing the journey
                </p>

                <div class="flex gap-4 justify-center sm:justify-start flex-wrap">
                  <a
                    href="/blog"
                    class="group relative px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl border-4 border-gray-900 dark:border-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] transition-all duration-200 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[6px_6px_0px_0px_rgba(255,255,255,1)] hover:-translate-y-0.5 active:translate-y-0.5 active:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]"
                  >
                    <span class="flex items-center gap-2">
                      Read Blog
                      <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                      </svg>
                    </span>
                  </a>

                  <a
                    href="https://twitter.com/alexivkin"
                    target="_blank"
                    rel="noopener"
                    class="group px-8 py-4 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-bold rounded-xl border-4 border-gray-900 dark:border-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] transition-all duration-200 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[6px_6px_0px_0px_rgba(255,255,255,1)] hover:-translate-y-0.5"
                  >
                    <span class="flex items-center gap-2">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"></path>
                      </svg>
                      Twitter
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Bento Grid Featured Posts -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="flex justify-between items-end mb-8">
          <div>
            <h2 class="text-4xl sm:text-5xl font-black mb-2 text-gray-900 dark:text-white">Latest Posts</h2>
            <p class="text-gray-600 dark:text-gray-400">Thoughts on building, AI, and indie hacking</p>
          </div>
          <a
            href="/blog"
            class="hidden sm:flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-bold rounded-lg border-3 border-gray-900 dark:border-white hover:-translate-y-1 transition-all duration-200 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.2)]"
          >
            View all
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Bento Grid Layout -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {featuredPosts.map((post, index) => {
            // Vary card sizes for bento grid effect
            const isLarge = index === 0;
            const isTall = index === 1 || index === 4;

            return (
              <article
                class={`group relative overflow-hidden rounded-2xl border-4 border-gray-900 dark:border-white transition-all duration-300 hover:-translate-y-2 hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[8px_8px_0px_0px_rgba(255,255,255,1)]
                  ${isLarge ? 'md:col-span-2 lg:col-span-2' : ''}
                  ${isTall ? 'md:row-span-2' : ''}
                `}
              >
                {/* Glassmorphic background */}
                <div class="absolute inset-0 bg-gradient-to-br from-white/90 via-blue-50/80 to-purple-50/90 dark:from-gray-900/90 dark:via-blue-950/80 dark:to-purple-950/90 backdrop-blur-sm"></div>

                {/* Color accent bar */}
                <div class={`absolute top-0 left-0 right-0 h-2 ${
                  index % 3 === 0 ? 'bg-gradient-to-r from-blue-500 to-purple-500' :
                  index % 3 === 1 ? 'bg-gradient-to-r from-pink-500 to-orange-500' :
                  'bg-gradient-to-r from-green-500 to-teal-500'
                }`}></div>

                <a href={`/blog/${post.slug}`} class="relative block p-6 sm:p-8 h-full">
                  <div class="flex flex-col h-full">
                    <div class="flex-1">
                      <time class="inline-block mb-3 px-3 py-1 text-xs font-bold uppercase tracking-wider bg-yellow-300 dark:bg-yellow-500 text-gray-900 rounded-full border-2 border-gray-900 dark:border-white">
                        {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </time>

                      <h3 class={`font-black leading-tight mb-3 text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors ${
                        isLarge ? 'text-3xl sm:text-4xl' : 'text-xl sm:text-2xl'
                      }`}>
                        {post.data.title}
                      </h3>

                      {(isLarge || isTall) && post.data.description && (
                        <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4">
                          {post.data.description}
                        </p>
                      )}

                      {post.data.tags && post.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-2 mt-4">
                          {post.data.tags.slice(0, 3).map(tag => (
                            <span class="px-2 py-1 text-xs font-semibold bg-gray-200 dark:bg-gray-800 rounded border border-gray-900 dark:border-gray-700">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>

                    <div class="mt-4 flex items-center gap-2 text-sm font-bold text-blue-600 dark:text-blue-400 group-hover:gap-3 transition-all">
                      Read more
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                      </svg>
                    </div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        <!-- Mobile View All Button -->
        <div class="sm:hidden mt-8 text-center">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-8 py-4 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-bold rounded-xl border-4 border-gray-900 dark:border-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)]"
          >
            View all posts
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </section>

      <!-- About Section (minimalist) -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl border-4 border-gray-900 dark:border-white rounded-2xl p-8 sm:p-12 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:shadow-[8px_8px_0px_0px_rgba(255,255,255,1)]">
          <h2 class="text-3xl sm:text-4xl font-black mb-6 text-gray-900 dark:text-white">About Me</h2>
          <div class="prose prose-lg dark:prose-invert max-w-none">
            <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-lg mb-4">
              I'm an indie hacker passionate about building products that people love. Currently exploring AI,
              attending hackathons, and shipping side projects every weekend.
            </p>
            <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-lg">
              Previously built and sold several apps. Now focused on documenting my journey,
              sharing lessons learned, and connecting with other makers.
            </p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  .group:hover .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>
