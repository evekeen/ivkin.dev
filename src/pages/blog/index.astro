---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Get unique tags
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))].sort();
---

<BaseLayout title="Blog - Alexander Ivkin" description="Thoughts on indie hacking, startups, and building products">
  <div class="flex flex-col min-h-screen bg-gray-50 dark:bg-[#0a0a0a]">
    <Header />

    <main class="flex-1">
      <section class="max-w-5xl mx-auto px-6 py-20">
        <!-- Header -->
        <div class="mb-16">
          <h1 class="text-5xl sm:text-6xl font-bold mb-4 text-gray-900 dark:text-white">
            All Posts
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-400">
            {allPosts.length} articles about building, AI, and indie hacking
          </p>
        </div>

        <!-- Tags Filter -->
        {allTags.length > 0 && (
          <div class="mb-12 pb-12 border-b-2 border-gray-200 dark:border-gray-800">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-500 mb-4">
              Topics
            </h2>
            <div class="flex flex-wrap gap-2">
              {allTags.map(tag => (
                <a
                  href={`/blog/tag/${tag}`}
                  class="px-4 py-2 bg-white dark:bg-gray-900 border-2 border-gray-200 dark:border-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-xl hover:border-gray-900 dark:hover:border-white hover:text-gray-900 dark:hover:text-white transition-colors text-sm"
                >
                  {tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Posts Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {allPosts.map((post) => (
            <article class="group">
              <a href={`/blog/${post.slug}`} class="block">
                <div class="bg-white dark:bg-gray-900 border-2 border-gray-200 dark:border-gray-800 rounded-2xl p-6 hover:border-gray-900 dark:hover:border-white transition-all h-full shadow-lg hover:shadow-xl hover:scale-[1.02] duration-300">
                  <div class="flex flex-col h-full">
                    {post.data.image && (
                      <img src={post.data.image} alt="" class="w-full h-40 object-cover rounded-xl mb-4" />
                    )}
                    <time class="text-xs font-mono text-gray-600 dark:text-gray-400 mb-4">
                      {post.data.date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </time>

                    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3 leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                      {post.data.title}
                    </h2>

                    {post.data.description && (
                      <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-4 line-clamp-2 flex-1">
                        {post.data.description}
                      </p>
                    )}

                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-gray-200 dark:border-gray-800">
                        {post.data.tags.slice(0, 3).map(tag => (
                          <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-lg">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
