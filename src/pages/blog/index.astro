---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Get unique tags
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))].sort();
---

<BaseLayout title="Blog - Alexander Ivkin" description="Thoughts on indie hacking, startups, and building products">
  <div class="flex flex-col min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-purple-50/30 dark:from-gray-950 dark:via-blue-950/20 dark:to-purple-950/20">
    <Header />

    <main class="flex-1">
      <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <!-- Header -->
        <div class="mb-12">
          <h1 class="text-5xl sm:text-6xl font-black mb-4 text-gray-900 dark:text-white">
            All Posts
          </h1>
          <p class="text-xl sm:text-2xl text-gray-700 dark:text-gray-300 font-medium">
            Thoughts on indie hacking, AI, and building products
          </p>
        </div>

        <!-- Tags Filter -->
        {allTags.length > 0 && (
          <div class="mb-12 bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl border-4 border-gray-900 dark:border-white rounded-2xl p-6 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:shadow-[6px_6px_0px_0px_rgba(255,255,255,1)]">
            <h2 class="text-sm font-bold uppercase tracking-wider text-gray-600 dark:text-gray-400 mb-4">Filter by topic</h2>
            <div class="flex flex-wrap gap-3">
              {allTags.map(tag => (
                <a
                  href={`/blog/tag/${tag}`}
                  class="px-4 py-2 text-sm font-bold bg-yellow-300 dark:bg-yellow-500 text-gray-900 rounded-lg border-2 border-gray-900 dark:border-white hover:-translate-y-0.5 transition-all duration-200 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Posts List -->
        <div class="space-y-6">
          {allPosts.map((post, index) => (
            <article class="group">
              <a
                href={`/blog/${post.slug}`}
                class="block bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl border-4 border-gray-900 dark:border-white rounded-2xl p-6 sm:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[8px_8px_0px_0px_rgba(255,255,255,1)] shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)]"
              >
                <!-- Color accent bar -->
                <div class={`absolute top-0 left-0 right-0 h-2 rounded-t-xl ${
                  index % 3 === 0 ? 'bg-gradient-to-r from-blue-500 to-purple-500' :
                  index % 3 === 1 ? 'bg-gradient-to-r from-pink-500 to-orange-500' :
                  'bg-gradient-to-r from-green-500 to-teal-500'
                }`}></div>

                <div class="flex flex-col sm:flex-row gap-6">
                  <div class="flex-1">
                    <div class="flex flex-wrap items-center gap-3 mb-4">
                      <time class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider bg-yellow-300 dark:bg-yellow-500 text-gray-900 rounded-full border-2 border-gray-900 dark:border-white">
                        {post.data.date.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        })}
                      </time>

                      {post.data.tags && post.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                          {post.data.tags.slice(0, 3).map(tag => (
                            <span class="px-2 py-1 text-xs font-semibold bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded border border-gray-900 dark:border-gray-700">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>

                    <h2 class="text-2xl sm:text-3xl font-black mb-3 text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-tight">
                      {post.data.title}
                    </h2>

                    {post.data.description && (
                      <p class="text-gray-700 dark:text-gray-300 leading-relaxed line-clamp-2 mb-4">
                        {post.data.description}
                      </p>
                    )}

                    <div class="flex items-center gap-2 text-sm font-bold text-blue-600 dark:text-blue-400 group-hover:gap-3 transition-all">
                      Read article
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
