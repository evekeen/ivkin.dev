---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Get unique tags
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))].sort();
---

<BaseLayout title="Blog - Alexander Ivkin" description="Thoughts on indie hacking, startups, and building products">
  <div class="flex flex-col min-h-screen">
    <Header />

    <main class="flex-1">
      <section class="max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 py-24">
        <!-- Header -->
        <div class="mb-20">
          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold mb-6 text-gray-900 dark:text-white tracking-tight">
            Writing
          </h1>
          <p class="text-xl sm:text-2xl text-gray-600 dark:text-gray-400 max-w-2xl leading-relaxed">
            Thoughts on building products, AI experiments, and the indie hacking journey.
          </p>
        </div>

        <!-- Tags Filter -->
        {allTags.length > 0 && (
          <div class="mb-16 pb-16 border-b border-gray-200 dark:border-gray-800">
            <h2 class="text-sm font-medium uppercase tracking-wider text-gray-500 dark:text-gray-500 mb-4">
              Filter by topic
            </h2>
            <div class="flex flex-wrap gap-3">
              {allTags.map(tag => (
                <a
                  href={`/blog/tag/${tag}`}
                  class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                >
                  {tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Posts List -->
        <div class="space-y-16">
          {allPosts.map((post) => (
            <article class="group">
              <a href={`/blog/${post.slug}`} class="block">
                <div class="space-y-3">
                  <time class="block text-sm font-medium text-gray-500 dark:text-gray-500 tracking-wide">
                    {post.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>

                  <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-tight">
                    {post.data.title}
                  </h2>

                  {post.data.description && (
                    <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-3xl">
                      {post.data.description}
                    </p>
                  )}

                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-3 pt-2">
                      {post.data.tags.map(tag => (
                        <span class="text-xs font-medium text-gray-500 dark:text-gray-500">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <div class="flex items-center gap-2 text-sm font-medium text-blue-600 dark:text-blue-400 opacity-0 group-hover:opacity-100 transition-opacity pt-2">
                    Read more
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
