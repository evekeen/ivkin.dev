---
// Giscus comments component
// https://giscus.app/
---

<div class="giscus-wrapper mt-16 pt-8 border-t-4 border-gray-900 dark:border-white">
  <h3 class="text-2xl font-black mb-6 text-gray-900 dark:text-white">Comments</h3>

  <script
    src="https://giscus.app/client.js"
    data-repo="evekeen/ivkin.dev"
    data-repo-id="R_kgDOMwdTVw"
    data-category="General"
    data-category-id="DIC_kwDOMwdTVw"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async>
  </script>
</div>

<style>
  .giscus-wrapper {
    @apply bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl rounded-2xl p-6 sm:p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:shadow-[8px_8px_0px_0px_rgba(255,255,255,1)];
  }

  :global(.giscus, .giscus-frame) {
    width: 100%;
  }
</style>
